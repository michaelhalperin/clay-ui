{
  "name": "clay-ui",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Clay UI — a soft, pastel React component library built with Tailwind CSS",
  "main": "./dist/clay-ui.cjs.js",
  "module": "./dist/clay-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/clay-ui.es.js",
      "require": "./dist/clay-ui.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./preset": "./clay-ui.preset.cjs"
  },
  "files": [
    "dist",
    "clay-ui.preset.cjs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "recharts": ">=2.0.0"
  },
  "dependencies": {
    "lucide-react": ">=0.400.0",
    "recharts": ">=2.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^5.0.1",
    "vitepress": "^1.6.4"
  }
}
